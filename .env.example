# Copy to .env for local dev. In production these go in Vercel →
# Settings → Environment Variables. Never commit the real .env.

# --- Database ---------------------------------------------------------
# Neon gives you two strings. Use the POOLED one (host contains "-pooler")
# as DATABASE_URL: serverless functions open a connection per invocation
# and would exhaust a direct Postgres connection limit within minutes.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/manychat?sslmode=require"

# The DIRECT (non-pooled) string. Prisma Migrate needs it — migrations
# can't run through a transaction pooler.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/manychat?sslmode=require"

# --- Painel -----------------------------------------------------------
# Guards everything except the webhook. If unset in production the panel
# locks itself (503) rather than opening. Use a long random string:
#   openssl rand -base64 24
ADMIN_PASSWORD=""

# --- Cron -------------------------------------------------------------
# Authorizes /api/cron/tick. Vercel sends it as a Bearer token.
#   openssl rand -hex 32
CRON_SECRET=""

# --- Meta / Instagram -------------------------------------------------
# App Dashboard → Configurações → Básico → Chave secreta do app.
IG_APP_SECRET=""

# A string you invent. Type the same value into the webhook config screen.
IG_VERIFY_TOKEN="troque-esta-string"

# Page access token for the Facebook Page linked to your IG pro account.
# Exchange the short-lived Explorer token for a long-lived one (README).
IG_PAGE_ACCESS_TOKEN=""

GRAPH_API_VERSION="v21.0"

# Messages per second for broadcasts. Instagram throttles bursts.
BROADCAST_RATE="5"
